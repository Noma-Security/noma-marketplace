{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run_codex_hook.sh\" || true",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\run_codex_hook.cmd\" & exit /B 0",
            "timeout": 25
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run_codex_hook.sh\" || true",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\run_codex_hook.cmd\" & exit /B 0",
            "timeout": 25
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run_codex_hook.sh\" || true",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\run_codex_hook.cmd\" & exit /B 0",
            "timeout": 25
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run_codex_hook.sh\" || true",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\run_codex_hook.cmd\" & exit /B 0",
            "timeout": 25
          }
        ]
      }
    ]
  }
}
