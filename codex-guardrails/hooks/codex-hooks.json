{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/common/run_hook.sh\" codex_hook.py || true",
            "commandWindows": "powershell.exe -NoProfile -Command \"& '${PLUGIN_ROOT}\\scripts\\common\\run_hook.cmd' codex_hook.py; exit 0\"",
            "timeout": 25
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/common/run_hook.sh\" codex_hook.py || true",
