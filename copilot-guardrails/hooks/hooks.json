{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "sh \"${PLUGIN_ROOT}/scripts/common/run_hook.sh\" copilot_hook.py userPromptSubmitted || true",
        "powershell": "& \"${PLUGIN_ROOT}\\scripts\\common\\run_hook.cmd\" copilot_hook.py userPromptSubmitted; exit 0",
        "timeoutSec": 25
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "sh \"${PLUGIN_ROOT}/scripts/common/run_hook.sh\" copilot_hook.py preToolUse || true",
        "powershell": "& \"${PLUGIN_ROOT}\\scripts\\common\\run_hook.cmd\" copilot_hook.py preToolUse; exit 0",
        "timeoutSec": 25
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "sh \"${PLUGIN_ROOT}/scripts/common/run_hook.sh\" copilot_hook.py postToolUse || true",
        "powershell": "& \"${PLUGIN_ROOT}\\scripts\\common\\run_hook.cmd\" copilot_hook.py postToolUse; exit 0",
        "timeoutSec": 25
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "sh \"${PLUGIN_ROOT}/scripts/common/run_hook.sh\" copilot_hook.py agentStop || true",
        "powershell": "& \"${PLUGIN_ROOT}\\scripts\\common\\run_hook.cmd\" copilot_hook.py agentStop; exit 0",
        "timeoutSec": 25
      }
    ]
  }
}
